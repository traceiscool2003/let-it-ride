const BOSS := {
	"draftqueens": ["Discard? Honey, I'm just getting started. And I'm drafting YOU.", "Oh, now it's personal. Full house, sweetie. My lineup, my rules, your funeral.", "Is that the best you can draw? My fantasy team would roast you.", "I read you at the flop. You looked boring. Still do.", "Cards don't lie. Neither does my eyeliner. Both are perfect.", "Ow! That's a three-hundred-dollar blazer! Also my face!", "Not the hair! My hair has a better record than your whole bloodline!", "Better luck next season, sweetie.", "That's a fold. Pack it up. We'll draft you next year."],
